# In den BESTEHENDEN HTTPS-VirtualHost einfügen.
# Vor sämtlichen allgemeinen ProxyPass-Regeln; Konflikte vorher ausschließen.
# TLS, Authentifizierung und bestehende Backend-Regeln bleiben erhalten.
ProxyPassMatch "^/(?:index\.html)?$" "!"
ProxyPassMatch "^/(leistungen|unternehmen|entwicklung|ki-musik|kontakt|impressum|datenschutz|entwicklung/rail-software|entwicklung/rail-software/demo-download)(?:/index\.html|/)?$" "!"
ProxyPass "/website-assets/" "!"

AliasMatch "^/(?:index\.html)?$" "/var/www/rail-website/current/index.html"
AliasMatch "^/(leistungen|unternehmen|entwicklung|ki-musik|kontakt|impressum|datenschutz|entwicklung/rail-software|entwicklung/rail-software/demo-download)(?:/index\.html|/)?$" "/var/www/rail-website/current/$1/index.html"
Alias "/website-assets/" "/var/www/rail-website/current/website-assets/"
<Directory "/var/www/rail-website/">
    Require all granted
    AllowOverride None
    Options -Indexes -ExecCGI
</Directory>

# Danach ALLE bisherigen Backend-Regeln unverändert beibehalten.
# KEIN statischer Catch-all und KEIN SPA-Fallback.
# Kontaktfragment separat VOR der allgemeinen Backend-Proxy-Regel ergänzen,
# wenn der getrennte Maildienst eingerichtet und getestet ist.
