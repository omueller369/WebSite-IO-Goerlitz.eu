[Unit]
Description=IO website contact mail service
After=network.target

[Service]
DynamicUser=yes
WorkingDirectory=/opt/io-website-contact
EnvironmentFile=/etc/io-website/contact.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/gunicorn --bind 127.0.0.1:8091 --workers 1 --threads 4 --timeout 30 --limit-request-line 4094 --limit-request-fields 30 contact:application
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
