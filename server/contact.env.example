# Installed root-only at /etc/io-website/contact.env; no password in this file.
SMTP_HOST=ctl-software.io-goerlitz.eu
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=info@io-goerlitz.eu
SMTP_USERNAME=info@io-goerlitz.eu
# Password: hidden prompt -> /etc/io-website/contact-password (0600)
# systemd LoadCredential exposes it only to the unprivileged mail service.
